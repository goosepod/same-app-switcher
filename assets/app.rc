// Windows resources compiled into SameAppSwitcher.exe by build.rs.
#include <windows.h>

#define IDD_SHORTCUT 101
#define IDC_HOTKEY   1001
#define IDC_WIN      1002
#define IDC_REVERSE  1003
#define IDC_RESET    1004
#define IDC_PREVIOUS 1005
#define IDC_PREVIOUS_WIN 1006

1 ICON "app.ico"
1 24 "app.manifest"

IDD_SHORTCUT DIALOGEX 0, 0, 276, 168
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SameAppSwitcher - Shortcuts"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "&Next window:", -1, 10, 10, 256, 10
    CONTROL         "", IDC_HOTKEY, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 10, 23, 256, 16
    AUTOCHECKBOX    "Also hold the &Windows key (next)", IDC_WIN, 10, 43, 256, 10
    LTEXT           "&Previous window:", -1, 10, 63, 256, 10
    CONTROL         "", IDC_PREVIOUS, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 10, 76, 256, 16
    AUTOCHECKBOX    "Also hold the W&indows key (previous)", IDC_PREVIOUS_WIN, 10, 96, 256, 10
    LTEXT           "", IDC_REVERSE, 10, 114, 256, 20
    PUSHBUTTON      "&Reset defaults", IDC_RESET, 10, 144, 86, 14
    DEFPUSHBUTTON   "OK", IDOK, 162, 144, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 216, 144, 50, 14
END

1 VERSIONINFO
FILEVERSION 0,3,0,0
PRODUCTVERSION 0,3,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "SameAppSwitcher - cycle windows of the same app"
      VALUE "FileVersion", "0.3.0"
      VALUE "InternalName", "SameAppSwitcher"
      VALUE "OriginalFilename", "SameAppSwitcher.exe"
      VALUE "ProductName", "SameAppSwitcher"
      VALUE "ProductVersion", "0.3.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
