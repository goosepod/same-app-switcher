// Windows resources compiled into SameAppSwitcher.exe by build.rs (via windres).
#include <windows.h>

#define IDD_SHORTCUT 101
#define IDC_HOTKEY   1001
#define IDC_WIN      1002
#define IDC_REVERSE  1003
#define IDC_RESET    1004

1 ICON "app.ico"
1 24 "app.manifest"

IDD_SHORTCUT DIALOGEX 0, 0, 236, 112
STYLE DS_MODALFRAME | DS_CENTER | DS_SHELLFONT | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SameAppSwitcher - Shortcut"
FONT 9, "Segoe UI"
BEGIN
    LTEXT           "Click the box below and press the shortcut you want:", -1, 10, 10, 216, 10
    CONTROL         "", IDC_HOTKEY, "msctls_hotkey32", WS_BORDER | WS_TABSTOP, 10, 24, 216, 14
    AUTOCHECKBOX    "Also hold the &Windows key", IDC_WIN, 10, 44, 216, 10
    LTEXT           "", IDC_REVERSE, 10, 60, 216, 20
    PUSHBUTTON      "&Reset to Alt+`", IDC_RESET, 10, 90, 72, 14
    DEFPUSHBUTTON   "OK", IDOK, 122, 90, 50, 14
    PUSHBUTTON      "Cancel", IDCANCEL, 176, 90, 50, 14
END

1 VERSIONINFO
FILEVERSION 0,2,0,0
PRODUCTVERSION 0,2,0,0
FILEOS 0x40004
FILETYPE 0x1
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904B0"
    BEGIN
      VALUE "FileDescription", "SameAppSwitcher - cycle windows of the same app"
      VALUE "FileVersion", "0.2.0"
      VALUE "InternalName", "SameAppSwitcher"
      VALUE "OriginalFilename", "SameAppSwitcher.exe"
      VALUE "ProductName", "SameAppSwitcher"
      VALUE "ProductVersion", "0.2.0"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
